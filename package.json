{
  "name": "pg-client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,server -c green,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "start:bg": "nohup tsx server/index.ts > app.log 2>&1 &",
    "deploy": "npm run build && npm run start:bg",
    "setup": "npm install && npm run build && npm run start:bg"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "cors": "^2.8.5",
    "element-plus": "^2.9.0",
    "express": "^4.21.0",
    "monaco-editor": "^0.52.0",
    "pg": "^8.13.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.0.0"
  }
}
